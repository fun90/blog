---
import { formatDate, getReadingTime, type BlogPost } from '../utils/posts';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const readingTime = getReadingTime(post.body);
---

<article class="group relative rounded-2xl border border-zinc-200/80 bg-white p-5 transition-all hover:border-sky-500/40 hover:shadow-sm dark:border-zinc-800/80 dark:bg-zinc-900/40 dark:hover:border-sky-400/40">
  <div class="mb-2.5 flex flex-wrap items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400">
    <span class="rounded-full bg-sky-50 px-2.5 py-0.5 font-medium text-sky-700 dark:bg-sky-500/10 dark:text-sky-300">
      {post.data.category}
    </span>
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    <span>·</span>
    <span>约 {readingTime} 分钟阅读</span>
  </div>

  <h3 class="text-lg font-semibold tracking-tight text-zinc-900 transition-colors group-hover:text-sky-600 dark:text-zinc-100 dark:group-hover:text-sky-400">
    <a href={`/blog/${post.id}`} class="after:absolute after:inset-0">
      {post.data.title}
    </a>
  </h3>

  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
    {post.data.description}
  </p>

  {
    post.data.tags.length > 0 && (
      <div class="mt-3.5 flex flex-wrap gap-1.5">
        {post.data.tags.map((tag) => (
          <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
            #{tag}
          </span>
        ))}
      </div>
    )
  }
</article>
