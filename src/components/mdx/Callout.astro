---
interface Props {
  type?: 'info' | 'tip' | 'warning';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const styles = {
  info: 'border-sky-500/30 bg-sky-50/70 text-sky-950 dark:bg-sky-500/10 dark:text-sky-100',
  tip: 'border-emerald-500/30 bg-emerald-50/70 text-emerald-950 dark:bg-emerald-500/10 dark:text-emerald-100',
  warning: 'border-amber-500/30 bg-amber-50/70 text-amber-950 dark:bg-amber-500/10 dark:text-amber-100',
};

const defaultTitles = {
  info: '说明',
  tip: '实战技巧',
  warning: '注意',
};
---

<aside class:list={['not-prose my-6 rounded-xl border p-4 text-sm leading-relaxed', styles[type]]}>
  <div class="mb-1 font-semibold">{title ?? defaultTitles[type]}</div>
  <div class="opacity-90">
    <slot />
  </div>
</aside>
