---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GISCUS, SITE } from '../../config';
import { formatDate, getPublishedPosts, getReadingTime } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: posts[index + 1] ?? null,
      nextPost: posts[index - 1] ?? null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);

const postUrl = new URL(`/blog/${post.id}`, Astro.site ?? SITE.url).toString();
const shareText = encodeURIComponent(`${post.data.title} — ${SITE.title}`);
const shareUrl = `https://x.com/intent/tweet?text=${shareText}&url=${encodeURIComponent(postUrl)}`;
const ogImage = post.data.ogImage ?? `/og/${post.id}.png`;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
  ogType="article"
  pubDate={post.data.pubDate}
>
  <article>
    <!-- Header -->
    <header class="mb-8 border-b border-zinc-200/80 pb-8 dark:border-zinc-800/80">
      <div class="mb-3 flex flex-wrap items-center gap-2 text-xs text-zinc-500 dark:text-zinc-400">
        <a href="/blog" class="hover:text-zinc-900 dark:hover:text-zinc-100">← 返回文章</a>
        <span>·</span>
        <span class="rounded-full bg-sky-50 px-2.5 py-0.5 font-medium text-sky-700 dark:bg-sky-500/10 dark:text-sky-300">
          {post.data.category}
        </span>
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <span>·</span>
        <span>约 {readingTime} 分钟阅读</span>
      </div>

      <h1 class="text-2xl font-bold tracking-tight text-zinc-950 sm:text-4xl dark:text-white">
        {post.data.title}
      </h1>

      <p class="mt-3 text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
        {post.data.description}
      </p>

      {
        post.data.tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-1.5">
            {post.data.tags.map((tag) => (
              <span class="rounded-md bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
                #{tag}
              </span>
            ))}
          </div>
        )
      }
    </header>

    <!-- Table of Contents -->
    {
      tocHeadings.length > 1 && (
        <details class="mb-8 rounded-xl border border-zinc-200/80 bg-zinc-50/70 p-4 text-sm dark:border-zinc-800/80 dark:bg-zinc-900/50" open>
          <summary class="cursor-pointer font-semibold text-zinc-900 dark:text-zinc-100">文章目录</summary>
          <ul class="mt-3 space-y-1.5 text-zinc-600 dark:text-zinc-400">
            {tocHeadings.map((h) => (
              <li class={h.depth === 3 ? 'pl-4 text-xs' : ''}>
                <a href={`#${h.slug}`} class="transition-colors hover:text-sky-600 dark:hover:text-sky-400">
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    <!-- Body -->
    <div class="prose prose-zinc max-w-none dark:prose-invert prose-headings:scroll-mt-20 prose-headings:font-semibold prose-img:rounded-xl">
      <Content />
    </div>

    <!-- X Share & Follow CTA -->
    <section class="mt-12 rounded-2xl border border-zinc-200/80 bg-zinc-50/80 p-6 dark:border-zinc-800/80 dark:bg-zinc-900/50">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <div>
          <h2 class="text-base font-semibold text-zinc-900 dark:text-zinc-100">觉得这篇文章有帮助？</h2>
          <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
            欢迎转发到 X 分享给更多开发者，也可以关注我获取最新的工具实战与开发干货。
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-2.5">
          <a
            href={shareUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-xl bg-zinc-900 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-zinc-800 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200"
          >
            分享到 X
          </a>
          <a
            href={SITE.twitterUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-xl border border-zinc-300 bg-white px-4 py-2 text-sm font-medium text-zinc-800 transition-colors hover:border-sky-500/50 hover:text-sky-600 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:border-sky-400/50 dark:hover:text-sky-400"
          >
            关注 {SITE.twitterHandle}
          </a>
        </div>
      </div>
    </section>

    <!-- Prev / Next -->
    {
      (prevPost || nextPost) && (
        <nav class="mt-10 grid gap-4 border-t border-zinc-200/80 pt-8 sm:grid-cols-2 dark:border-zinc-800/80">
          {prevPost ? (
            <a
              href={`/blog/${prevPost.id}`}
              class="rounded-xl border border-zinc-200/80 p-4 transition-colors hover:border-sky-500/40 dark:border-zinc-800/80"
            >
              <div class="text-xs text-zinc-500 dark:text-zinc-400">← 上一篇</div>
              <div class="mt-1 font-medium text-zinc-900 dark:text-zinc-100">{prevPost.data.title}</div>
            </a>
          ) : (
            <div />
          )}
          {nextPost && (
            <a
              href={`/blog/${nextPost.id}`}
              class="rounded-xl border border-zinc-200/80 p-4 text-right transition-colors hover:border-sky-500/40 dark:border-zinc-800/80"
            >
              <div class="text-xs text-zinc-500 dark:text-zinc-400">下一篇 →</div>
              <div class="mt-1 font-medium text-zinc-900 dark:text-zinc-100">{nextPost.data.title}</div>
            </a>
          )}
        </nav>
      )
    }

    <!-- Optional Giscus Comments -->
    {
      GISCUS.enabled && (
        <section class="mt-12 border-t border-zinc-200/80 pt-8 dark:border-zinc-800/80">
          <script
            is:inline
            src="https://giscus.app/client.js"
            data-repo={GISCUS.repo}
            data-repo-id={GISCUS.repoId}
            data-category={GISCUS.category}
            data-category-id={GISCUS.categoryId}
            data-mapping="pathname"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="top"
            data-theme="preferred_color_scheme"
            data-lang="zh-CN"
            crossorigin="anonymous"
            async
          />
        </section>
      )
    }
  </article>
</BaseLayout>

<!-- Code block copy button -->
<script is:inline>
  document.querySelectorAll('.prose pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.textContent = '复制';
    btn.className =
      'absolute right-2.5 top-2.5 cursor-pointer rounded-md border border-zinc-300/80 bg-white/90 px-2 py-1 text-xs font-medium text-zinc-600 transition-colors hover:text-zinc-900 dark:border-zinc-700 dark:bg-zinc-800/90 dark:text-zinc-300 dark:hover:text-white';
    btn.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.innerText ?? pre.innerText;
      await navigator.clipboard.writeText(code);
      btn.textContent = '已复制';
      setTimeout(() => (btn.textContent = '复制'), 1500);
    });
    pre.appendChild(btn);
  });
</script>
