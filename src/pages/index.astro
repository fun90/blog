---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE } from '../config';
import { TOOLS } from '../data/tools';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 6);
const featuredTools = TOOLS.filter((t) => t.featured).slice(0, 4);
---

<BaseLayout>
  <!-- Hero -->
  <section class="pb-12 pt-4">
    <div class="inline-flex items-center gap-2 rounded-full border border-zinc-200 bg-zinc-50 px-3 py-1 text-xs font-medium text-zinc-600 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400">
      <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
      AI Agent · 软件工程 · 实用工具
    </div>

    <h1 class="mt-5 text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl dark:text-white">
      把实战摸索的 AI 经验与趁手工具，<br class="hidden sm:inline" />沉淀成长期可复用的知识库。
    </h1>

    <p class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-600 dark:text-zinc-400">
      我是 {SITE.author}，关注终端 Coding Agent 工作流、工程效率与实用在线工具沉淀。这里记录真实开发中的打磨过程，也整理了长期收藏的高频工具清单。
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 rounded-xl bg-zinc-900 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-zinc-800 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200"
      >
        阅读最新文章
      </a>
      <a
        href="/tools"
        class="inline-flex items-center gap-2 rounded-xl border border-zinc-300 bg-white px-4 py-2.5 text-sm font-medium text-zinc-800 transition-colors hover:border-sky-500/50 hover:text-sky-600 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:border-sky-400/50 dark:hover:text-sky-400"
      >
        浏览常用工具精选
      </a>
      <a
        href={SITE.twitterUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-xl px-3 py-2.5 text-sm font-medium text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
      >
        X ({SITE.twitterHandle}) ↗
      </a>
      <a
        href={SITE.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-xl px-3 py-2.5 text-sm font-medium text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100"
      >
        GitHub ↗
      </a>
    </div>
  </section>

  <!-- Latest Articles -->
  <section class="border-t border-zinc-200/80 py-10 dark:border-zinc-800/80">
    <div class="mb-6 flex items-end justify-between">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-zinc-950 dark:text-white">最新文章</h2>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">开发经验总结与工具深度使用指南</p>
      </div>
      <a href="/blog" class="text-sm font-medium text-sky-600 hover:text-sky-500 dark:text-sky-400">
        查看全部 →
      </a>
    </div>

    <div class="grid gap-4">
      {recentPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <!-- Featured Tools -->
  <section class="border-t border-zinc-200/80 py-10 dark:border-zinc-800/80">
    <div class="mb-6 flex items-end justify-between">
      <div>
        <h2 class="text-xl font-bold tracking-tight text-zinc-950 dark:text-white">常用工具精选</h2>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">按场景整理的高频在线工具与实用站点</p>
      </div>
      <a href="/tools" class="text-sm font-medium text-sky-600 hover:text-sky-500 dark:text-sky-400">
        工具精选页 →
      </a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        featuredTools.map((tool) => (
          <a
            href={tool.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col justify-between rounded-2xl border border-zinc-200/80 bg-white p-5 transition-all hover:border-sky-500/40 hover:shadow-sm dark:border-zinc-800/80 dark:bg-zinc-900/40 dark:hover:border-sky-400/40"
          >
            <div>
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-semibold text-zinc-900 transition-colors group-hover:text-sky-600 dark:text-zinc-100 dark:group-hover:text-sky-400">
                  {tool.name}
                </h3>
                <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">
                  {tool.pricing}
                </span>
              </div>
              <p class="mt-1 text-xs font-medium text-sky-600 dark:text-sky-400">{tool.tagline}</p>
              <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{tool.description}</p>
            </div>
            <div class="mt-4 flex items-center justify-between text-xs text-zinc-500 dark:text-zinc-400">
              <span>{tool.category}</span>
              <span class="transition-transform group-hover:translate-x-0.5">直达官网 ↗</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
